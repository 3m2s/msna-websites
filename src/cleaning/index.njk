layout: false
permalink: /cleaning/
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MSNA Cleaning & Support</title>
<style>
  :root{ --bg:#0a0908; --ink:#f3efe6; --gold:#c9a227; --gold-bright:#e9c75b; --ink-dim:#b7ae9e; color-scheme:dark; }
  *{box-sizing:border-box;}
  html,body{margin:0;height:100%;}
  body{
    background: radial-gradient(ellipse 900px 600px at 50% 30%, rgba(201,162,39,.09), transparent 60%), var(--bg);
    color:var(--ink); font-family:'Segoe UI', Helvetica, Arial, sans-serif;
    display:flex; align-items:center; justify-content:center; min-height:100%;
    padding:24px;
  }
  .card{ text-align:center; display:flex; flex-direction:column; align-items:center; gap:1.6rem; max-width:360px; }
  .card img{ width:56px; height:56px; object-fit:contain; }
  .card h1{ font-size:1rem; letter-spacing:.24em; margin:0; font-weight:500; }
  .card h1 b{ color:var(--gold-bright); font-weight:500; }
  .langs{ display:flex; gap:.75rem; }
  .langs a{ text-decoration:none; color:var(--ink); border:1px solid rgba(201,162,39,.3); padding:.7em 1.3em; border-radius:2px; font-size:.75rem; letter-spacing:.14em; transition: border-color .2s ease, color .2s ease; }
  .langs a:hover{ border-color: var(--gold); color: var(--gold-bright); }
  .note{ color: var(--ink-dim); font-size:.72rem; }
</style>
</head>
<body>
  <div class="card">
    <img src="/assets/img/logo-mark.png" alt="MSNA emblem">
    <h1>MSNA <b>CLEANING &amp; SUPPORT</b></h1>
    <div class="langs"><a href="en/">English</a><a href="nl/">Nederlands</a><a href="fr/">Français</a></div>
    <p class="note" id="note">Redirecting…</p>
  </div>
  <script>
    (function(){
      try{
        var saved = null; try { saved = localStorage.getItem('msna-lang'); } catch(e) {}
        var l = (saved || navigator.language || 'en').toLowerCase();
        var target = 'en/';
        if (l.indexOf('nl') === 0) target = 'nl/';
        else if (l.indexOf('fr') === 0) target = 'fr/';
        window.location.replace(target);
      }catch(e){}
    })();
  </script>
</body>
</html>

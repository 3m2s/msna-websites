---
title: Contact
permalink: /group/contact/
description: "Neem contact op met MSNA Group Services. Wij verwijzen u door naar het juiste MSNA-bedrijf."
---
<section class="hero hero-sm">
  <div class="wrap">
    <p class="breadcrumb"><a href="/group/">Home</a> / Contact</p>
    <span class="eyebrow">Contact</span>
    <h1>Neem contact op met de groep</h1>
    <p class="lead">Een algemene vraag of weet u niet bij welk bedrijf u moet zijn? Wij helpen u verder.</p>
  </div>
</section>

<section class="section section-cream">
  <div class="wrap split">
    <div>
      <h2>Contactgegevens</h2>
      <hr class="rule">
      <ul class="contact-list">
        <li><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/></svg></span>
          <div><small>Telefoon</small><a href="{{ site.phone | telHref }}">{{ site.phone }}</a></div></li>
        <li><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg></span>
          <div><small>Contactpersoon</small>{{ site.contactName }}</div></li>
        {% if site.email %}<li><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg></span>
          <div><small>E-mail</small><a href="mailto:{{ site.email }}">{{ site.email }}</a></div></li>{% endif %}
        {% if site.address %}<li><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s7-6 7-12a7 7 0 00-14 0c0 6 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
          <div><small>Adres</small>{{ site.address }}</div></li>{% endif %}
      </ul>
      <h3>Rechtstreeks naar een bedrijf</h3>
      <ul class="checklist">
        <li><a href="/cleaning/offerte/">Offerte schoonmaak – MSNA Cleaning & Support</a></li>
        <li><a href="/mode/">MSNA MODE</a> (binnenkort)</li>
        <li><a href="/estate/">MSNA Estate</a> (binnenkort)</li>
      </ul>
    </div>

    <div class="form-card">
      <h2 style="font-size:2rem">Stel uw vraag</h2>
      <form class="form" data-form data-endpoint="{{ site.formEndpoint }}" action="{{ site.formEndpoint or '#' }}" method="post">
        <input type="hidden" name="_subject" value="Contactaanvraag via MSNA Group Services">
        <input type="hidden" name="website" value="Group Services">
        <div class="form-row">
          <div class="field"><label for="c-name">Naam <span class="req">*</span></label><input id="c-name" name="naam" required autocomplete="name"></div>
          <div class="field"><label for="c-company">Bedrijf</label><input id="c-company" name="bedrijf" autocomplete="organization"></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="c-email">E-mail <span class="req">*</span></label><input id="c-email" type="email" name="email" required autocomplete="email"></div>
          <div class="field"><label for="c-phone">Telefoon</label><input id="c-phone" type="tel" name="telefoon" autocomplete="tel"></div>
        </div>
        <div class="field">
          <label for="c-about">Uw vraag gaat over</label>
          <select id="c-about" name="onderwerp">
            <option>Algemene vraag aan de groep</option>
            <option>MSNA Cleaning & Support</option>
            <option>MSNA MODE</option>
            <option>MSNA Estate</option>
            <option>Samenwerking</option>
          </select>
        </div>
        <div class="field"><label for="c-msg">Bericht <span class="req">*</span></label><textarea id="c-msg" name="bericht" required></textarea></div>
        {% set submitLabel = "Verstuur bericht" %}
        {% include "partials/form-status.njk" %}
      </form>
    </div>
  </div>
</section>

{%- set brandKey = brand or "hub" -%}
{%- set b = brands[brandKey] -%}
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seoTitle or ((title + " | " + b.full) if title else b.full) }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <meta name="theme-color" content="#0b0b0d">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ seoTitle or title or b.full }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:image" content="/assets/img/og.jpg">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <link rel="preload" href="/assets/fonts/cormorant-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="brand-{{ brandKey }}{% if b.mobileBar %} has-mobile-bar{% endif %}">
  <a class="skip-link" href="#main">Naar de inhoud</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% if b.mobileBar %}
  <div class="mobile-bar">
    <a class="btn btn-ghost" href="{{ site.phone | telHref }}">Bel ons</a>
    <a class="btn btn-gold" href="{{ b.cta.url }}">{{ b.cta.label }}</a>
  </div>
  {% endif %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>

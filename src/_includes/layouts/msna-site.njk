{#- Gedeelde layout voor de startpagina (Group Services), Cleaning & Support en Estate.
    Nodig in de front matter: siteKey (hub|cleaning|estate), lang, pageKey, title.
    Alle links lopen via msnaUrl, zodat de bezoeker in dezelfde taal blijft. -#}
{%- set s = sites[siteKey] -%}
{%- set t = s.t[lang] -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% if s.isHub and pageKey == "home" and lang == s.rootLang %}<script>
  // Eerder voor Engels of Frans gekozen? Dan meteen naar die startpagina.
  try { var l = localStorage.getItem("msna-lang"); if (l === "en" || l === "fr") location.replace(l + "/"); } catch (e) {}
</script>
{% endif %}<title>{{ title }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% for l in s.langs %}<link rel="alternate" hreflang="{{ l }}" href="{{ (siteKey + ':' + pageKey) | msnaUrl(l) }}">
{% endfor %}<link rel="icon" type="image/png" href="/assets/img/logo-mark.png">
<meta property="og:image" content="{{ site.url }}/assets/img/og.png">
<link rel="stylesheet" href="/assets/css/fonts-msna.css">
<link rel="stylesheet" href="/assets/css/msna.css">
</head>
<body>
{%- set langSwitch -%}
{% for l in s.langs %}{% if not loop.first %}<span class="sep">/</span>{% endif %}<a{% if l == lang %} class="current" aria-current="true"{% endif %} href="{{ (siteKey + ':' + pageKey) | msnaUrl(l) }}" hreflang="{{ l }}" lang="{{ l }}" title="{{ sites.langNames[l] }}">{{ l | upper }}</a>{% endfor %}
{%- endset %}
<header class="site">
  <div class="bar">
    <a class="brand" href="{{ (siteKey + ':home') | msnaUrl(lang) }}">
      <img src="/assets/img/logo-mark.png" alt="MSNA emblem">
      <span>
        <span class="wordmark">MSNA <b>{{ s.wordmark | safe }}</b></span>
        <span class="sub">{{ t.sub }}</span>
      </span>
    </a>
    <nav class="main">
      {% for key in s.navOrder %}<a href="{{ (siteKey + ':' + key) | msnaUrl(lang) }}"{% if key == pageKey %} class="active" aria-current="page"{% endif %}>{{ t.nav[key] }}</a>
      {% endfor %}
      <div class="lang-switch nav-langs">{{ langSwitch | safe }}</div>
    </nav>
    <div class="head-right">
      {% if not s.isHub %}<a class="home-btn" href="{{ 'hub:home' | msnaUrl(lang) }}" title="{{ sites.homeButton[lang] }}" aria-label="{{ sites.homeButton[lang] }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5.5 9.5V20h5v-5.5h3V20h5V9.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span>{{ sites.homeButton[lang] }}</span>
      </a>{% endif %}
      <div class="lang-switch">{{ langSwitch | safe }}</div>
      <a class="btn btn-gold btn-sm hide-mobile" href="{{ (siteKey + ':' + s.ctaKey) | msnaUrl(lang) }}">{{ t.cta }}</a>
      <button class="menu-toggle" aria-label="Menu" aria-expanded="false">&#9776;</button>
    </div>
  </div>
</header>
{{ content | safe }}
  {% if not s.isHub %}<div class="group-strip">
    <div class="wrap row">
      <p>{{ t.strip }}</p>
      <span>
        {% for link in s.stripLinks %}<a class="other-site" href="{{ link.site | msnaUrl(lang) }}">{{ link.label[lang] }} &rarr;<span class="tag">{{ sites.otherTag[lang] }}</span></a>&nbsp;·&nbsp; {% endfor %}<a class="other-site" href="{{ 'hub:home' | msnaUrl(lang) }}">{{ sites.homeButton[lang] }} &rarr;</a>
      </span>
    </div>
  </div>{% endif %}
  <footer class="site">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <div class="foot-brand">
            <img src="/assets/img/logo-mark.png" alt="MSNA emblem">
            <span class="wordmark">MSNA <b>{{ s.wordmark | safe }}</b></span>
          </div>
          <p>{{ t.blurb }}</p>
        </div>
        <div>
          <h4>{{ t.navHeading }}</h4>
          <ul>{% for key in s.navOrder %}<li><a href="{{ (siteKey + ':' + key) | msnaUrl(lang) }}">{{ t.nav[key] }}</a></li>{% endfor %}</ul>
        </div>
        <div>
          <h4>Contact</h4>
          <ul>
            <li><a href="{{ site.phone | telHref }}">{{ site.phone }}</a></li>
            {% set mail = s.email or site.email %}{% if mail %}<li><a href="mailto:{{ mail }}">{{ mail }}</a></li>{% endif %}
            <li>{{ site.contactName }}</li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <span>{{ t.bottom }} · <a href="{{ 'hub:privacy' | msnaUrl(lang) }}">{{ t.privacy }}</a></span>
      </div>
    </div>
  </footer>
  <script>window.MSNA_FORM_CONFIG = window.MSNA_FORM_CONFIG || null;</script>
  <script src="/assets/js/msna.js"></script>
</body>
</html>

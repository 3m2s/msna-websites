<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="logo" href="{{ b.home }}">
        <img src="/assets/img/emblem.webp" alt="" width="44" height="40">
        <span class="logo-text"><strong>MSNA</strong><small>{{ b.sub }}</small></span>
      </a>
      <p>{{ b.blurb or "Ondernemerschap, dienstverlening, mode en vastgoed onder één groep." }}</p>
    </div>

    {% if b.nav.length %}
    <div>
      <h2 class="footer-title">Pagina's</h2>
      <ul class="footer-links">
        {% for item in b.nav %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    <div>
      <h2 class="footer-title">Contact</h2>
      <ul class="footer-links">
        <li><a href="{{ site.phone | telHref }}">{{ site.phone }}</a></li>
        <li>{{ site.contactName }}</li>
        {% if site.email %}<li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
        {% if site.address %}<li>{{ site.address }}</li>{% endif %}
      </ul>
    </div>

    <div>
      <h2 class="footer-title">MSNA-bedrijven</h2>
      <ul class="footer-links">
        {% for c in companies %}
        {% if c.key != brandKey %}
        <li><a href="{{ c.url }}">MSNA {{ c.name }}</a>{% if c.status == "soon" %} <span class="tag">binnenkort</span>{% endif %}</li>
        {% endif %}
        {% endfor %}
      </ul>
      {% if brandKey != "hub" %}<p class="footer-note">Via deze links gaat u naar een ander bedrijf binnen MSNA Group Services.</p>{% endif %}
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {{ site.year }} {{ b.full }}{% if site.companyNumber %} · Ondernemingsnummer {{ site.companyNumber }}{% endif %}</p>
    <ul>
      <li><a href="/privacy/">Privacyverklaring</a></li>
      <li><a href="/privacy/#cookies">Cookies</a></li>
    </ul>
  </div>
</footer>

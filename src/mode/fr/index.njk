          </div>
          <div class="contact-row">
            <a class="val" href="tel:+32479014393">+32 479 01 43 93</a>
            <button class="copy-btn" type="button" data-copy="+32 479 01 43 93" data-label-copy="Copier" data-label-copied="Copié">Copier</button>
          </div>
          <div class="contact-row">
            <span class="val">www.msna-mode.be</span>
            <span class="copy-btn" aria-hidden="true" style="visibility:hidden">Copier</span>
          </div>
        </div>
      </div>
    </div>
  </section>

